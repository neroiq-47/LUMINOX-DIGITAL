# All values are public (baked into the static site at build time).
# Set them as GitHub repository variables (Settings → Secrets and variables → Actions → Variables).

# Stripe Payment Link for donations (£25 minimum, £10,000 maximum is enforced by Stripe).
NEXT_PUBLIC_DONATION_URL=

# Optional: form endpoint (e.g. https://formspree.io/f/xxxx) that accepts JSON POSTs for the contact form.
NEXT_PUBLIC_FORM_ENDPOINT=

# Optional: an external chat API (POST {messages} → {reply}). Without it the built-in offline guide answers.
NEXT_PUBLIC_CHAT_API_URL=
